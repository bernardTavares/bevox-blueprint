.loop/iterations.jsonl
.loop/decisions.md
.loop/notes.md
.loop/notes-archive.md
.loop/improvements-log.jsonl
.loop/.backlog-drained
.loop/crons.md
.loop/config/crons.md
.loop/cron-logs/
.loop/locks/
.loop/worktrees/
.loop/HALTED.md
.loop/HUMAN_NEEDED.md
.loop/violations.jsonl
.loop/merge-conflicts.jsonl
.loop/missions/
.loop/cron-prompts/
.loop/canary-failures.jsonl
